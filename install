#!/bin/bash
# Copies this workflow into Alfred's preferences, over the installed copy, for development.
set -euo pipefail

cd "$(dirname "$0")"
prefs=$(defaults read com.runningwithcrayons.Alfred-Preferences syncfolder 2>/dev/null || echo ~/Library/Application\ Support/Alfred)
prefs="${prefs/#\~/$HOME}/Alfred.alfredpreferences/workflows"
bundleid=$(/usr/libexec/PlistBuddy -c "Print :bundleid" src/info.plist)
dest=$(grep -l "<string>$bundleid</string>" "$prefs"/*/info.plist 2>/dev/null | head -1 | xargs -I{} dirname {} || true)
if [[ -z "$dest" ]]; then
    echo "Not installed yet: run ./bundle --install first" >&2
    exit 1
fi
cp -R src/ "$dest/"
echo "Installed to $dest"
